#include <stdio.h>
#include <stdlib.h>
#include <locale.h>
#include "45.h"

int main() {
    setlocale(LC_ALL,"Russian");
    setlocale(LC_NUMERIC, "C");

    FILE *finA,*finB,*finC, *fout;

    finA = fopen("finA45.txt", "r");
    finB = fopen("finB45.txt", "r");
    finC = fopen("finC45.txt", "r");
    fout = fopen("fout.txt", "w");

    int nA, nB, nC;

    do{
        printf("Введите количество элементов nA: ");
        scanf("%i", &nA);
    }while (nA<1 || nA>20);

    do{
        printf("Введите количество элементов nB: ");
        scanf("%i", &nB);
    }while (nB<1 || nB>20);

    do{
        printf("Введите количество элементов nC: ");
        scanf("%i", &nC);
    }while (nC<1 || nC>20);

    int *A, *B, *C;
    VvodVector(&A, nA, finA);
    VvodVector(&B, nB, finB);
    VvodVector(&C, nC, finC);

    fclose(finA);
    fclose(finB);
    fclose(finC);

    fprintf(fout, "Введен вектор A\n");
    VivodVector(A, nA, fout);
    fprintf(fout, "Введен вектор B\n");
    VivodVector(B, nB, fout);
    fprintf(fout, "Введен вектор C\n");
    VivodVector(C, nC, fout);

    int flA,flB, flC;
    Kratno5(&flA, nA, A);
    Kratno5(&flB, nB, B);
    Kratno5(&flC, nC, C);

    int imaxA, iminA, imaxB,iminB, imaxC, iminC;
    IndexMax(&imaxA, nA, A);
    IndexMin(&iminA, nA, A);
    IndexMax(&imaxB, nB, B);
    IndexMin(&iminB, nB, B);
    IndexMax(&imaxC, nC, C);
    IndexMin(&iminC, nC, C);

    if (flA==0 && flB==0 && flC==0){
        fprintf(fout, "Условие не выплнено, ни в олном из массивов нет подходящих элементов\n");
    }
    else {
        fprintf(fout, "Условие выполнено\n");
    }

    if (flA==1){
        fprintf(fout, "Все элементы массива A кратны 5\n");
        fprintf(fout, "Индекс максимального элемента: %i\n", imaxA+1 );
        fprintf(fout, "Индекс минимального элемента: %i\n", iminA+1 );
            if (imaxA>iminA){
                    fprintf(fout, "Индекс максимального элемента больше индекса минимального\n");
            }
            else{
                fprintf(fout, "Индекс максимального элемента не больше индекса минимального\n");
            }
    }
    else {
        fprintf(fout, "не все элементы массива A кратны 5\n");
    }

     if (flB==1){
        fprintf(fout, "Все элементы массива B кратны 5\n");
        fprintf(fout, "Индекс максимального элемента: %i\n", imaxB+1 );
        fprintf(fout, "Индекс минимального элемента: %i\n", iminB+1 );
            if (imaxB>iminB){
                    fprintf(fout, "Индекс максимального элемента больше индекса минимального\n");
            }
            else{
                fprintf(fout, "Индекс максимального элемента не больше индекса минимального\n");
            }
    }
    else {
        fprintf(fout, "не все элементы массива B кратны 5\n");
    }

     if (flC==1){
        fprintf(fout, "Все элементы массива C кратны 5\n");
        fprintf(fout, "Индекс максимального элемента: %i\n", imaxC+1 );
        fprintf(fout, "Индекс минимального элемента: %i\n", iminC+1 );
            if (imaxC>iminC){
                    fprintf(fout, "Индекс максимального элемента больше индекса минимального\n");
            }
            else{
                fprintf(fout, "Индекс максимального элемента не больше индекса минимального\n");
            }
    }
    else {
        fprintf(fout, "не все элементы массива C кратны 5\n");
    }

    FreeVector(&A);
    FreeVector(&B);
    FreeVector(&C);
    fclose(fout);
}
