#include <stdio.h>
#include <stdlib.h>
#include "46.h"

void VvodVector(float **x, int nx, FILE *fin){
    *x = (float*)malloc(nx * sizeof(float));
    for (int i = 0; i < nx; i++) {
        fscanf(fin, "%f", &(*x)[i]);
    }
}

void VivodVector(float *x, int nx, FILE *fout){
    for (int i = 0; i < nx; i++) {
        fprintf(fout, "%5.2f ", x[i]);
    }
    fprintf(fout, "\n");
}

void VivodNomera(int *x, int nx, FILE *fout){
    for (int i = 0; i < nx; i++) {
        fprintf(fout, "%i ", x[i]);
    }
    fprintf(fout, "\n");
}

void VneDiapazona(float *x, int nx, float l, float h, int **result, int *nresult){
    *result = (int*)malloc(nx * sizeof(int));
    *nresult = 0;
    for (int i = 0; i < nx; i++) {
        if (x[i] < l || x[i] > h) {
            (*result)[*nresult] = i + 1;
            (*nresult)++;
        }
    }
}

